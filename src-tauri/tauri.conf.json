{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/schemas/2.0.0/tauri.config.json",
  "productName": "Sticky Todo",
  "version": "0.2.1",
  "identifier": "com.stickytodo.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "便签 Todo",
        "width": 320,
        "height": 480,
        "minWidth": 280,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
